# Install only after the acceptance DNS record and HTTPS certificate are ready.
# Keep the hostname on a dedicated subdomain and route it only to port 3001.
server {
    listen 80;
    server_name alipay-acceptance.d2s.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name alipay-acceptance.d2s.top;

    ssl_certificate /etc/letsencrypt/live/alipay-acceptance.d2s.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alipay-acceptance.d2s.top/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
