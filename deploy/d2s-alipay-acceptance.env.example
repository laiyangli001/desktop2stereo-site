# Copy to /opt/d2s-alipay-acceptance/.env on the server and replace every placeholder through the server's secret manager.
# Never commit the populated file. This stack uses its own database, Redis, host directories, and localhost port.
POSTGRES_USER=d2s_acceptance_owner
POSTGRES_PASSWORD=replace_with_random_url_safe_secret
POSTGRES_DB=d2s_acceptance
REDIS_PASSWORD=replace_with_random_url_safe_secret

D2S_APP_IMAGE=new-api-desktop2stereo-site:acceptance
D2S_NEW_API_CONTAINER_NAME=d2s-alipay-acceptance-app
D2S_REDIS_CONTAINER_NAME=d2s-alipay-acceptance-redis
D2S_POSTGRES_CONTAINER_NAME=d2s-alipay-acceptance-postgres
D2S_HOST_BIND_ADDRESS=127.0.0.1
D2S_HOST_PORT=3001
D2S_DATA_DIR=/opt/d2s-alipay-acceptance/data
D2S_LOG_DIR=/opt/d2s-alipay-acceptance/logs
D2S_UPDATE_REQUESTS_DIR=/opt/d2s-alipay-acceptance/update-requests
NODE_NAME=d2s-alipay-acceptance

SESSION_SECRET=replace_with_independent_random_secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://alipay-acceptance.d2s.top
TRUSTED_PROXIES=127.0.0.1
D2S_DEVICE_VERIFICATION_URI=https://alipay-acceptance.d2s.top/device
# Use the production-compatible signing key only through the server secret manager,
# so acceptance entitlements match the installed client's trust configuration.
D2S_LICENSE_KEY_ID=d2s-es256-2026-09
D2S_LICENSE_PRIVATE_KEY_B64=replace_with_server_license_signing_key_base64

# Use separate database roles/passwords for the runtime, migration, and cleanup identities.
# Provision these roles only inside the acceptance database before starting the app.
D2S_APP_SQL_DSN=postgresql://d2s_app:replace_with_app_password@postgres:5432/d2s_acceptance?sslmode=disable
D2S_AUDIT_MIGRATION_DIALECT=postgres
D2S_AUDIT_MIGRATION_DSN=postgresql://d2s_migrator:replace_with_migration_password@postgres:5432/d2s_acceptance?sslmode=disable
D2S_AUDIT_CLEANUP_DSN=postgresql://d2s_audit_cleanup:replace_with_cleanup_password@postgres:5432/d2s_acceptance?sslmode=disable

# Initialize a separate D2S super admin in this isolated instance.
D2S_ADMIN_BOOTSTRAP_EMAIL=acceptance-admin@example.invalid
D2S_ADMIN_BOOTSTRAP_PASSWORD=replace_with_unique_bootstrap_password

# A live Alipay application is used only in this isolated instance.
# Keep these values in the server secret manager and inject them into this env file at deploy time.
D2S_PURCHASES_ENABLED=true
D2S_ALIPAY_PC_ENABLED=true
D2S_ALIPAY_APP_ID=replace_with_live_app_id
D2S_ALIPAY_SELLER_ID=replace_with_live_seller_id
D2S_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
D2S_ALIPAY_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace_with_live_merchant_private_key\n-----END PRIVATE KEY-----
D2S_ALIPAY_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nreplace_with_live_alipay_public_key\n-----END PUBLIC KEY-----
D2S_ALIPAY_NOTIFY_URL=https://alipay-acceptance.d2s.top/api/v1/alipay/d2s/notify
D2S_ALIPAY_RETURN_URL=https://alipay-acceptance.d2s.top/d2s

# Do not enable project self-updates or reconciliation jobs in the acceptance stack.
D2S_UPDATE_ENABLED=false
D2S_RECONCILIATION_TOKEN=
